#!/bin/sh
# ============================================================
# pre-push — lưới an toàn tự động cho solo dev.
# Chặn push nếu test đỏ, migration vi phạm luật DB, hoặc lệnh bot/web lệch.
# Kích hoạt: tự bật qua `npm install` (script "prepare" đặt core.hooksPath),
#            hoặc chạy 1 lần: git config core.hooksPath scripts/git-hooks
# Bỏ qua khẩn cấp (hạn chế dùng): git push --no-verify
# ============================================================
set -e

echo "[pre-push] Chạy test (lint + i18n + unit + bất biến kinh tế)..."
npm test || { echo "[pre-push] ❌ Test ĐỎ — huỷ push. Sửa rồi push lại (hoặc --no-verify nếu thật sự cần)."; exit 1; }

# Gate tầng DB. Luật ở AGENTS.md §2 (nguyên tử / least-privilege / idempotent / đánh số
# tăng) trước nay chỉ là văn xuôi và đã bị vi phạm lặp lại — nay là exit 1.
echo "[pre-push] Kiểm tra luật migration SQL..."
node scripts/check-sql-policy.js || { echo "[pre-push] ❌ Migration vi phạm luật DB — huỷ push. Xem gợi ý sửa ở trên."; exit 1; }

echo "[pre-push] Kiểm tra status RPC ↔ tầng lệnh..."
node scripts/check-rpc-status.js || { echo "[pre-push] ❌ RPC có status MỚI chưa được xử lý — huỷ push."; exit 1; }

echo "[pre-push] Kiểm tra đồng bộ lệnh bot ↔ web..."
node scripts/check-command-sync.js || { echo "[pre-push] ❌ Lệnh bot/web LỆCH — huỷ push. Cập nhật web/CommandsExplorer.tsx."; exit 1; }

# Nửa còn lại của Luật 7: gate trên chỉ soi bot↔web, nên /help trôi mất 11 lệnh mà không
# ai biết — gồm cả /start và /study, hai lệnh có 0 lượt dùng vì không ai khám phá ra.
echo "[pre-push] Kiểm tra đồng bộ lệnh bot ↔ /help..."
node scripts/check-help-sync.js || { echo "[pre-push] ❌ /help LỆCH danh sách lệnh — huỷ push. Cập nhật CATEGORIES + vi.json/en.json."; exit 1; }

echo "[pre-push] ✅ Qua cổng an toàn — cho push."
